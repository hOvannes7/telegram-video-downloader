{
   "action": {
      "default_icon": {
         "16": "icons/16.png",
         "48": "icons/48.png",
         "128": "icons/128.png"
      },
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "js": [ "content_tg.js" ],
      "matches": [ "https://web.telegram.org/*" ]
   } ],
   "description": "Download videos and images from Telegram Web",
   "host_permissions": [ "http://*/*", "https://*/*" ],
   "icons": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
   },
   "manifest_version": 3,
   "name": "Telegram Video Downloader",
   "permissions": [ "storage" ],
   "version": "1.0.0",
   "web_accessible_resources": [ {
      "matches": [ "*://*/*" ],
      "resources": [ "popup.html", "icons/*", "inject.js" ]
   } ]
}
